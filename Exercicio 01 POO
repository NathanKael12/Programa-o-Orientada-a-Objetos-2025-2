class Book:
    def __init__(self, title, author, year):
        self.title = title
        self.author = author
        self.year = year

    def __str__(self):
        return f"'{self.title}' por {self.author} ({self.year})"

class Usuario:
    def __init__(self, nome, endereco, idade):
        self.nome = nome
        self.endereco = endereco
        self.idade = idade
        self.livros_alugados = []  # Lista vazia de livros alugados

    def __str__(self):
        livros_str = ", ".join([str(livro) for livro in self.livros_alugados]) if self.livros_alugados else "Nenhum"
        return f"Nome: {self.nome}\nEndereço: {self.endereco}\nIdade: {self.idade}\nLivros Alugados: {livros_str}"

