(float temp) {
        if (temp > setPoint + histerese) {
            vent->ligar();
        } else if (temp < setPoint - histerese) {
            vent->desligar();
        }
    }
};

int main() {
    Sensor s(25.0);
    Ventilador v;
    Controlador c(26.0, 1.0, &v);

    for (int i = 0; i < 30; i++) {
        float t = s.getTemperatura();
        c.controlar(t);
        s.atualizar(v.estaLigado());

        cout << "Iteracao " << i+1
             << " | Temp: " << t << " C"
             << " | Ventilador: " << (v.estaLigado() ? "Ligado" : "Desligado")
             << endl;

        this_thread::sleep_for(chrono::milliseconds(500));
    }

    return 0;
}
